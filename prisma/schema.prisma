// Prisma schema — 오늘의수학 (testautocreator)
// 참조: docs/planning/04-database-design.md (ERD, 9개 엔티티)
//       docs/planning/02-trd.md §2.2 (Prisma + Zod + Auth.js)
//       docs/planning/07-coding-convention.md §2.2 (네이밍: 모델 PascalCase / 컬럼 camelCase → DB snake_case)
//
// 네이밍 규칙: 모델/필드는 Prisma Client 관례(PascalCase/camelCase)를 따르고,
// @map/@@map으로 실제 DB 컬럼·테이블명을 snake_case로 매핑한다.
// 예외: Account 모델의 OAuth 토큰 필드(refresh_token 등)는 @auth/prisma-adapter 표준 스키마가
// 정확한 필드명을 요구하므로 그대로 snake_case 식별자를 사용한다 (아래 주석 참조).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase 전환 시 커넥션 풀러(pgbouncer) 우회용 직결 URL.
  // 로컬 개발에서는 DATABASE_URL과 동일 값을 사용해도 무방.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enum
// ─────────────────────────────────────────────

/// 문제 출처 — D-04
enum ProblemSource {
  manual // 자작
  past_exam // 기출
  transformed // 변형
  ai_generated // AI 생성

  @@map("problem_source")
}

/// 난이도
enum Difficulty {
  easy
  mid
  hard

  @@map("difficulty")
}

/// 문제 검수 상태 — D-22 (pending → approved 승격 후 출제)
enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

/// 시험지 유형 — 일일 / 확인
enum TestType {
  daily
  review

  @@map("test_type")
}

/// 시험지 상태 흐름 — draft → confirmed → printed
enum TestStatus {
  draft
  confirmed
  printed

  @@map("test_status")
}

/// 문제 풀 — D-31. 기본 shared. private는 소유자만 조회.
enum ProblemPool {
  shared
  private

  @@map("problem_pool")
}

// ─────────────────────────────────────────────
// FEAT-0: 사용자 (강사) — 04 §2.1
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  /// 이메일 가입 시만 값 존재 (bcrypt 해시). 구글 로그인은 NULL
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  name          String    @db.VarChar(50)
  /// Auth.js(@auth/prisma-adapter) 표준 필드 — OAuth 이메일 인증 시각
  emailVerified DateTime? @map("email_verified")
  /// Auth.js 표준 필드 — OAuth 프로필 이미지 (최소 수집 원칙과 무관, 로그인 부가 정보)
  image         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// Soft delete — 탈퇴 후 30일 뒤 배치로 Hard delete (04 §4)
  deletedAt     DateTime? @map("deleted_at")

  classes  Class[]
  problems Problem[]
  tests    Test[]
  accounts Account[]
  sessions Session[]

  @@map("user")
}

// ─────────────────────────────────────────────
// FEAT-4: 반 — 04 §2.6
// ─────────────────────────────────────────────

model Class {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String   @db.VarChar(100)
  grade               String   @db.VarChar(10)
  /// 기본 문항 수 (기본값 8)
  defaultProblemCount Int      @default(8) @map("default_problem_count")
  /// 난이도 배분 — 예: {"easy":3,"mid":4,"hard":1}
  /// 기본값은 DB가 아닌 앱(계약) 레벨에서 적용 (04 §2.6)
  difficultyRatio     Json     @map("difficulty_ratio") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  students   Student[]
  progresses Progress[]
  tests      Test[]

  @@index([userId])
  @@map("class")
}

// ─────────────────────────────────────────────
// FEAT-4: 학생 — 04 §2.6 (최소 수집: 이름만)
// ─────────────────────────────────────────────

model Student {
  id                    String  @id @default(uuid()) @db.Uuid
  classId               String  @map("class_id") @db.Uuid
  name                  String  @db.VarChar(50)
  useIndividualProgress Boolean @default(false) @map("use_individual_progress")

  /// 재학 학교 — '오늘의 시험' 예측 대상을 정한다(트랙 E).
  /// 표기는 eywa `school-name.ts` 규칙으로 정규화해 넣는다("경명여자중학교" → "경명여중").
  schoolName  String? @map("school_name") @db.VarChar(50)
  /// "중" | "고". 초등은 내신이 없어 대상이 아니다.
  schoolLevel String? @map("school_level") @db.VarChar(2)
  schoolGrade Int?    @map("school_grade")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  progresses  Progress[]
  tests       Test[]
  testResults TestResult[]

  @@index([classId])
  @@map("student")
}

// ─────────────────────────────────────────────
// FEAT-1: 교육과정 단원 (기준 데이터) — 04 §2.2
// ─────────────────────────────────────────────

model Unit {
  id         String @id @default(uuid()) @db.Uuid
  grade      String @db.VarChar(10)
  chapter    String @db.VarChar(100)
  section    String @db.VarChar(100)
  /// 교육과정 순서 — 진도 "다음으로" 이동, 확인테스트 범위 계산의 기준
  orderIndex Int    @map("order_index")

  progresses     Progress[]
  problems       Problem[]
  examQuestions  ExamQuestion[]
  testRangeStart Test[]         @relation("TestRangeStartUnit")
  testRangeEnd   Test[]         @relation("TestRangeEndUnit")

  @@index([grade, orderIndex])
  @@map("unit")
}

// ─────────────────────────────────────────────
// FEAT-4: 진도 기록 — 04 §2.6
// ─────────────────────────────────────────────

model Progress {
  id         String   @id @default(uuid()) @db.Uuid
  classId    String   @map("class_id") @db.Uuid
  /// NULL이면 반 전체 진도, 값이 있으면 해당 학생 개별 진도
  studentId  String?  @map("student_id") @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  /// 기록일 (날짜만 — 시각 불필요)
  recordedAt DateTime @map("recorded_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([classId, recordedAt(sort: Desc)])
  @@index([studentId, recordedAt(sort: Desc)])
  @@map("progress")
}

// ─────────────────────────────────────────────
// FEAT-1, 5: 문제은행 — 04 §2.3
// ─────────────────────────────────────────────

model Problem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid

  source          ProblemSource
  /// 변형 문제의 원본 참조 (원본 삭제 시 참조만 해제 — 변형본은 독립 자산으로 유지)
  originProblemId String?       @map("origin_problem_id") @db.Uuid

  difficulty   Difficulty
  /// 계산 / 개념 / 활용 / 서술형 — 확장 가능성 고려해 자유 문자열로 유지 (열거형 아님)
  problemType  String     @map("problem_type") @db.VarChar(20)
  /// 출제 형식 — 객관식 | 단답형 | 서술형.
  /// ⚠️ `problemType`(계산/개념/활용/서술형)과 **다른 축**이다. 섞지 말 것.
  /// mapProblemType 이 객관식→"개념" 으로 뭉개 원본 구분이 소실돼 있었다(11 §2.4).
  /// 청사진의 유형 배분(학교 고유성 51.1%)을 채우려면 이 컬럼이 필요하다.
  questionType String?    @map("question_type") @db.VarChar(10)
  /// 문제 본문 — LaTeX 수식 포함 마크다운
  content      String     @db.Text
  answer       String     @db.Text
  solution     String?    @db.Text
  /// 문항에 딸린 도형 SVG (testchanger figure engine 산출물, inline 렌더).
  /// 원본 시험지의 그림을 대체한다 — 이미지 파일이 아니라 SVG 문자열로 보관해
  /// 인쇄·화면이 같은 벡터를 쓰고 해상도 손실이 없다. 참조: docs/planning/09-figure-engine-guide.md
  figureSvg    String?    @map("figure_svg") @db.Text
  /// 도형 출처: engine(엔진 작도) / image(외부 이미지 보정본) / source(원본 시험지 오려옴)
  figureSource String?    @map("figure_source") @db.VarChar(20)
  /// 원본 시험지에서 오려 온 그림 파일 경로들 (`/figures/<examId>/qNN.jpg`).
  /// 완료본 PDF 에 그림이 **이미지로 심겨 있어** 다시 그릴 필요가 없다 —
  /// 원본을 그대로 오려 `public/figures/` 에 두고 여기에 경로만 적는다.
  /// 배열인 이유: 선택지마다 그림인 문항이 있다(실측 한 문항 최대 6장).
  /// 순서는 지면에 나온 순서다. 참조: docs/planning/09-figure-engine-guide.md
  figureUrls   String[]   @map("figure_urls")

  // ── 원본 역추적 메타데이터 (docs/planning/08-import-ledger.md) ──────────────
  // 추출기는 이 값들을 이미 갖고 있었는데 적재 단계가 버려서, 훼손·그림 문항을
  // 원본 시험지로 되짚을 수 없었다(2026-08-14). externalId는 재이관 멱등 키다.
  /// 원본 고유 키 (기출: `{exam_id}-{문항번호}`, RPM: 원본 행 id)
  externalId       String?      @unique @map("external_id") @db.VarChar(120)
  /// N드라이브 원본 파일 경로 (scripts/qa/nfile-inventory.txt.gz 기준 상대경로)
  sourceFile       String?      @map("source_file") @db.VarChar(500)
  school           String?      @db.VarChar(50)
  subject          String?      @db.VarChar(50)
  /// 시험 식별자 — 예: `2023-donmun-2-1`
  examId           String?      @map("exam_id") @db.VarChar(120)
  /// 원본 시험지에서의 문항 번호
  questionNumber   Int?         @map("question_number")
  /// 배점 (3, 3.5 등)
  score            Float?
  /// AI 생성물은 pending으로 시작, 검수 후 approved (D-22)
  reviewStatus     ReviewStatus @default(pending) @map("review_status")
  /// RPM 원본 잠금 (D-26) — false면 출제 풀에서 제외하고 변형 원본으로만 쓴다.
  directUseAllowed Boolean      @default(true) @map("direct_use_allowed")
  /// 공용 풀이 기본 (D-31). private는 소유자만 조회.
  pool             ProblemPool  @default(shared)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit                Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  originProblem       Problem?        @relation("ProblemOrigin", fields: [originProblemId], references: [id], onDelete: SetNull)
  transformedProblems Problem[]       @relation("ProblemOrigin")
  testProblems        TestProblem[]
  problemAnswers      ProblemAnswer[]

  // 자동 출제 조회 핵심 인덱스
  @@index([unitId, difficulty, reviewStatus, directUseAllowed])
  @@index([userId, unitId])
  @@index([originProblemId])
  @@index([pool, unitId, reviewStatus, directUseAllowed])
  @@map("problem")
}

// ─────────────────────────────────────────────
// EXAM — 기출 시험지 1편 (트랙 E · 11-score-predictor.md §3 L0)
//
// ⚠️ Problem 과 목적이 다르다. Problem 은 **출제용**이라 문항 단위로 정규화·필터링돼
//    시험지 통계가 이미 깨져 있다(적재에서 탈락한 문항이 있다). 예측기는 시험지 통계를
//    그대로 써야 하므로 **추출 JSON 원본**에서 이쪽을 만든다.
// ─────────────────────────────────────────────

model Exam {
  id String @id @default(uuid()) @db.Uuid

  /// 외부 인덱스 키(exam_index.db 의 exams.id). 재적재 멱등 키다.
  externalExamId String @unique @map("external_exam_id") @db.VarChar(120)

  school     String  @db.VarChar(50)
  /// "중" | "고"
  level      String  @db.VarChar(2)
  grade      Int
  /// 우리 교육과정 트리 라벨("중3", "공통수학1")
  subject    String  @db.VarChar(50)
  /// 시험지 원본 표기("수학", "수상"). 원문을 버리지 않는다.
  subjectRaw String? @map("subject_raw") @db.VarChar(50)

  year     Int
  semester Int
  /// "중간" | "기말"
  round    String @db.VarChar(4)

  totalScore    Float @map("total_score")
  questionCount Int   @map("question_count")

  sourceFile String?  @map("source_file") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  questions ExamQuestion[]

  /// 시리즈를 시간순으로 세우는 조회 — 예측의 기본 질의다.
  @@index([school, level, grade, subject, year, semester, round])
  @@index([level, grade, subject, year, semester, round])
  @@map("exam")
}

model ExamQuestion {
  id     String @id @default(uuid()) @db.Uuid
  examId String @map("exam_id") @db.Uuid

  number Int
  /// 배점. 3.2·3.4 처럼 소수 배점이 흔하다 — 반올림하지 말 것.
  score  Float
  /// 객관식 | 단답형 | 서술형
  qtype  String @db.VarChar(10)

  /// 시험지 원본의 사람 난이도 라벨: 하 | 중 | 상.
  /// ⚠️ Difficulty(easy/mid/hard)와 **다른 축**이다. 섞지 말 것.
  /// ⚠️ 배점으로 추정해 채우지 말 것 — 난이도로 점수를 예측하면 순환 논리가 된다(11 §2.4).
  difficultyLabel String? @map("difficulty_label") @db.VarChar(4)

  /// ⚠️ 시험지 원문 소단원 표기. 우리 트리로 매핑해도 이 값은 **보존한다**.
  /// 학교마다 단원을 부르는 이름이 다르고, 그 표기 자체가 출제 패턴 신호다.
  topicRaw String? @map("topic_raw") @db.VarChar(100)
  /// 매핑 실패 시 null. 버리지 않는다.
  unitId   String? @map("unit_id") @db.Uuid

  answer    String? @db.Text
  hasFigure Boolean @default(false) @map("has_figure")
  /// 문제은행과 연결됐으면 그 id (없을 수 있다)
  problemId String? @map("problem_id") @db.Uuid

  exam Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([examId, number])
  @@index([unitId])
  @@map("exam_question")
}

// ─────────────────────────────────────────────
// FEAT-1: 시험지 — 04 §2.4
// ─────────────────────────────────────────────

model Test {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  /// NULL이면 반 전체 대상
  studentId String? @map("student_id") @db.Uuid

  testType TestType @map("test_type")

  /// 확인테스트 범위 시작 (일일테스트는 NULL)
  rangeStartUnitId String? @map("range_start_unit_id") @db.Uuid
  /// 범위 끝 (일일테스트는 현재 진도 소단원)
  rangeEndUnitId   String  @map("range_end_unit_id") @db.Uuid

  status    TestStatus @default(draft)
  /// 검수 중 문제 교체 발생 여부 — 무수정 사용률 측정 (입력 지표 ②)
  modified  Boolean    @default(false)
  /// 테스트 예정일
  testDate  DateTime   @map("test_date") @db.Date
  /// 인쇄 시각 — 노스스타(주 5일 사용) 측정
  printedAt DateTime?  @map("printed_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  rangeStartUnit Unit?         @relation("TestRangeStartUnit", fields: [rangeStartUnitId], references: [id], onDelete: Restrict)
  rangeEndUnit   Unit          @relation("TestRangeEndUnit", fields: [rangeEndUnitId], references: [id], onDelete: Restrict)
  testProblems   TestProblem[]
  testResults    TestResult[]

  @@index([userId, testDate(sort: Desc)])
  @@index([classId, testDate(sort: Desc)])
  @@index([studentId])
  @@map("test")
}

// ─────────────────────────────────────────────
// FEAT-1: 시험지-문제 연결 — 04 §2.5
// ─────────────────────────────────────────────

model TestProblem {
  id         String  @id @default(uuid()) @db.Uuid
  testId     String  @map("test_id") @db.Uuid
  problemId  String  @map("problem_id") @db.Uuid
  /// 문항 번호
  orderIndex Int     @map("order_index")
  /// 검수 중 교체된 문항 여부
  replaced   Boolean @default(false)

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([testId, orderIndex])
  @@index([problemId])
  @@map("test_problem")
}

// ─────────────────────────────────────────────
// v2 "오늘의 시험"(기출 예상 점수 판독기) T7.1 — 학생 응시 결과
// 참조: docs/planning/11-score-predictor.md §1 (산출물 A/B/C)
//
// ⚠️ 이 3개 모델은 06-database-design.md(v1 ERD)에는 없다 — v2 신규 기능이라
//    이 스키마 파일 안에서 SSOT를 새로 정의한다(T7.1 지시서 기준).
// 참조: docs/planning/07-coding-convention.md §2.2 (네이밍 규칙)
// ─────────────────────────────────────────────

/// 시험 응시 결과 — 한 학생이 한 시험지(Test)를 푼 1회 채점 기록.
/// 같은 (testId, studentId) 재응시/재채점을 막지 않는다(재시험·정정 입력 허용) — 최신값은
/// takenAt 내림차순 조회로 가른다.
model TestResult {
  id             String   @id @default(uuid()) @db.Uuid
  testId         String   @map("test_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  /// 응시(채점 입력) 일시 — 별도 입력이 없으면 서버 처리 시각
  takenAt        DateTime @default(now()) @map("taken_at")
  /// 자동 채점 총점
  score          Float
  /// 판독기 계산값 — src/lib/predictor/predictStudentScore.ts (v0, 잠정) 산출물.
  /// ⚠️ 진짜 능력 추정 엔진(11-score-predictor.md §1-B)이 아직 없어 잠정 추정치다.
  predictedScore Float    @map("predicted_score")
  createdAt      DateTime @default(now()) @map("created_at")

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        ProblemAnswer[]
  /// 1:1 — 실제 FK는 AnalysisReport.testResultId(unique)가 소유한다(순환 FK 회피).
  analysisReport AnalysisReport?

  @@index([testId, studentId, takenAt])
  @@map("test_result")
}

/// 문항별 학생 응답 + 자동 채점 결과.
model ProblemAnswer {
  id           String @id @default(uuid()) @db.Uuid
  testResultId String @map("test_result_id") @db.Uuid
  problemId    String @map("problem_id") @db.Uuid

  /// 객관식 선택 번호(1~5) — 서술형이거나 미답이면 NULL
  selectedChoice Int?    @map("selected_choice")
  /// 서술형 채점 점수(0~100, 배점 대비 비율) — 객관식이거나 미답이면 NULL
  essayScore     Float?  @map("essay_score")
  /// 자동 채점 결과 — 객관식은 정답 일치, 서술형은 essayScore 기준선 판정(잠정 60점)
  isCorrect      Boolean @map("is_correct")
  /// 시험지 내 문항 순서(TestProblem.orderIndex 대응)
  sequence       Int

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([testResultId, sequence])
  @@map("problem_answer")
}

/// 응시 1건에 대한 분석 리포트 — 단원별 성적·난이도 분포·복습 추천 단원.
model AnalysisReport {
  id           String @id @default(uuid()) @db.Uuid
  /// 1:1 FK(unique) — 이 모델이 관계를 소유한다.
  testResultId String @unique @map("test_result_id") @db.Uuid

  totalScore             Float    @map("total_score")
  predictedScore         Float    @map("predicted_score")
  /// {unitId: 정답률(0~100)} — 04-database-design.md 스타일과 달리 v2 신규라 jsonb로 유지
  unitScores             Json     @map("unit_scores") @db.JsonB
  /// {difficulty(easy|mid|hard): {correct, total}}
  difficultyDistribution Json     @map("difficulty_distribution") @db.JsonB
  /// 복습 추천 단원 id 배열 — 정답률 낮은 순 최대 3개(잠정 기준선 60%)
  recommendedUnits       String[] @map("recommended_units")

  createdAt DateTime @default(now()) @map("created_at")

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@map("analysis_report")
}

// ─────────────────────────────────────────────
// Auth.js (NextAuth v5) — @auth/prisma-adapter 표준 스키마
// 참조: https://authjs.dev/getting-started/adapters/prisma
// 주의: Account의 OAuth 토큰 필드는 어댑터가 Prisma Client 필드명을
// 그대로(snake_case) 읽으므로 @map으로 camelCase 매핑하지 않는다.
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}
