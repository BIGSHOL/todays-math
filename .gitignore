scripts/qa/_*

# verify-convert-rpm --fault 가 만드는 변환기 임시 사본.
# 정상 종료 시 스스로 지우지만, 중간에 죽으면 남는다. 절대 커밋되면 안 된다
# — 일부러 망가뜨린 변환기다.
src/lib/import/_convertRpm.fault.*.ts

