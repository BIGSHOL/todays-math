# 테스트 전용 환경 변수 템플릿 (T0.4)
# 로컬에서 이 파일을 `.env.test`로 복사해 사용한다 (.env.test는 .gitignore 처리됨).
#
# Vitest는 기본 mode="test"로 실행되며, vitest.config.mts가
# loadEnv(mode, cwd, "")로 .env → .env.test → .env.test.local 순서로 값을
# 병합해 test.env(process.env)에 주입한다. 즉 .env.test에 정의한 값이
# .env의 값을 오버라이드한다 (개발 DB와 테스트 DB 분리 목적).
#
# 현재 DB 연결 자체는 보류 중(T0.2)이므로 아래는 구조만 준비한 상태이며,
# 실제 연결 시 운영과 분리된 테스트 전용 스키마/데이터베이스를 가리켜야 한다
# (예: 별도 DB명 app_test, 또는 테스트 전용 PostgreSQL 스키마).

# PostgreSQL — 테스트 전용 DB (운영/개발과 분리)
POSTGRES_DB=app_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app_test

# Auth.js — 테스트에서는 더미 값 사용 (실제 비밀값 아님)
AUTH_SECRET=test-secret-do-not-use-in-production

# DeepSeek API — 테스트에서는 항상 모킹, 실호출 금지 (02-trd.md §7.3)
DEEPSEEK_API_KEY=test-deepseek-key-mocked
