   "q": 449,
   "before": null,
   "after": "$\\frac{\\sqrt{6}-\\sqrt{3}}{\\sqrt{6}+\\sqrt{3}}-\\frac{\\sqrt{6}+\\sqrt{3}}{\\sqrt{6}-\\sqrt{3}} =\\frac{(\\sqrt{6}-\\sqrt{3})^{2}}{(\\sqrt{6}+\\sqrt{3})(\\sqrt{6}-\\sqrt{3})}-\\frac{(\\sqrt{6}+\\sqrt{3})^{2}}{(\\sqrt{6}-\\sqrt{3})(\\sqrt{6}+\\sqrt{3})} =\\frac{6-2\\sqrt{18}+3}{6-3}-\\frac{6+2\\sqrt{18}+3}{6-3} 9+6\\sqrt{2} =\\frac{9-6\\sqrt{2}}{3}- 3 =3-2\\sqrt{2}-(3+2\\sqrt{2}) =-4\\sqrt{2}$"
  },
  {
   "id": "21a55889-68fc-400b-9a5e-ed2d3ce0ac66",
