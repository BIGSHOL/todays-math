, "contents": [{"type": "equation", "value": "(1+2i)(2+3i)=-4+7i"}]}, {"number": 5, "contents": [{"type": "equation", "value": "\\frac{1-i}{2+i}=\\frac{1}{5}-\\frac{3i}{5}"}]}]}, {"number": 8, "score": 4.3, "type": "객관식", "label": null, "contents": [{"type": "text", "value": "다음 중 옳지 __않은__ 것은?"}], "choices": [{"number": 1, "contents": [{"type": "equation", "value": "(x+3y)(x^{2}-3xy+9y^{2})=x^{3}+27y^{3}"}]}, {"number": 2, "contents": [{"type": "equation", "value": "(2x-y)^{3}=8x^{3}+12x^{2}y-6xy^{2}-y^{3}"}]}, {"number": 3, "contents": [{"type": "equation", "value": "x^{3}+6x^{2}y+12xy^{2}+8y^{3}=(x+2y)^{3}"}]}, {"number": 4, "contents": [{"type": "equation", "value": "x^{3}+3x^{2}+5x+3=(x+1)(x^{2}+2x+3)"}]}, {"number": 5, "contents": [{"type": "equation", "value": "(a+b-2c)^{2}=a^{2}+b^{2}+4c^{2}+2(ab-2bc-2ca)"}]}]}, {"number": 9, "score": 4.4, "type": "객관식", "label": null, "contents": [{"type": "text", "value": "이차식 x^{2}-6x+10을 복소수 범위에서 인수분해하면?"}], "choices": [{"number": 1, "contents": [{"type": "equation", "value": "(x-3-i)(x-3+i)"}]}, {"number": 2, "contents": [{"type": "equation", "value": "(x+3-i)(x-3+i)"}]}, {"number": 3, "contents": [{"type": "equation", "value": "(x+3-i)(x+3+i)"}]}, {"number": 4, "contents": [{"type": "equation", "value": "(x+3-\\sqrt{2}i)(x-3+\\sqrt{2}i)"}]}, {"number": 5, "contents": [{"type": "equation", "value": "(x-3-\\sqrt{2}i)(x+3-\\sqrt{2}i)"}]}]}, {"number": 10, "score": 4.4, "type": "객관식", "label": null, "contents": [{"type": "text", "value": "(x^{3}+x^{2}-2x+b)(x^{2}-3x+a)를 전개한 식에서 x^{2}의 계수가 3, 상수항이 2일 때, |a-b|의 값은?"}], "choices": [{"number": 1, "contents": [{"type": "equation", "value": "1"}]}, {"number": 2, "contents": [{"type": "equation", "value": "2"}]}, {"number": 3, "contents": [{"type": "equation", "value": "3"}]}, {"number": 4, "contents": [{"type": "equation", "value": "4"}]}, {"number": 5, "contents": [{"type": "equation", "value": "5"}]}]}, {"number": 11, "score": 4.4, "type": "객관식", "label": null, "contents": [{"