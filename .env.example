# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Supabase 전환 시: 커넥션 풀러(pgbouncer, 6543 포트)를 우회하는 직결 URL — 마이그레이션 전용.
# 로컬 Docker 개발 환경에서는 DATABASE_URL과 동일한 값을 사용.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/app

# Auth.js — AUTH_SECRET 없으면 로그인 시 Server error (MissingSecret)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API
ANTHROPIC_API_KEY=your-api-key-here

# 공유 Supabase에 classified 문항을 공용 풀로 넣을 때만 1. 평소에는 두지 말 것.
# ALLOW_SHARED_IMPORT=1
